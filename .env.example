# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flavorpilot

# MCP Client Configuration
# Set to false to connect to REAL Zomato MCP server, true for mock data
USE_MOCK_MCP=false

# Zomato MCP Server Configuration (Official Public Server)
ZOMATO_MCP_TRANSPORT=http
ZOMATO_MCP_SERVER_URL=https://mcp-server.zomato.com/mcp

# Alternative transports (not needed for official server)
# ZOMATO_MCP_TRANSPORT=sse
# ZOMATO_MCP_SERVER_URL=http://localhost:8080/sse
# ZOMATO_MCP_TRANSPORT=stdio
# ZOMATO_MCP_STDIO_CMD=node /path/to/zomato-mcp-server/dist/index.js

# Zomato API Configuration (may not be needed for public MCP server)
ZOMATO_API_KEY=not_required_for_public_mcp

# FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Model Router Configuration
SMART_INTERN_MODEL=meta-llama/llama-3.3-70b-instruct
PHD_REASONER_MODEL=anthropic/claude-sonnet-4
ROUTING_THRESHOLD=0.75
