# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flavorpilot

# MCP Client Configuration  
# IMPORTANT: Set to false to use REAL Zomato MCP server
USE_MOCK_MCP=false

# Official Zomato MCP Server (Public)
ZOMATO_MCP_TRANSPORT=http
ZOMATO_MCP_SERVER_URL=https://mcp-server.zomato.com/mcp

# FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Model Router Configuration
SMART_INTERN_MODEL=meta-llama/llama-3.3-70b-instruct
PHD_REASONER_MODEL=anthropic/claude-sonnet-4
ROUTING_THRESHOLD=0.75
